{
 "id": "/fansave/",
 "name": "飯省 FanSave",
 "short_name": "飯省",
 "description": "找 CP 值最高的飯店",
 "lang": "zh-TW",
 "dir": "ltr",
 "start_url": "/fansave/",
 "scope": "/fansave/",
 "display": "standalone",
 "orientation": "portrait",
 "background_color": "#FBF5EC",
 "theme_color": "#FFF8EF",
 "icons": [
  {
   "src": "/fansave/icons/icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "/fansave/icons/icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "/fansave/icons/maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "share_target": {
  "action": "/fansave/share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "url": "url",
   "files": [
    {
     "name": "image",
     "accept": [
      "image/*",
      ".jpg",
      ".jpeg",
      ".png",
      ".webp",
      ".heic"
     ]
    }
   ]
  }
 }
}